# Generated by plotwork generate from the source ci (github-actions: .github/workflows/check.yml).
# The next run writes over this file. Put changes in docs/ci.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Pull request checks" direction=down desc="2 jobs and their steps of the check workflow, started by a pull request or a push to main, in the order their needs set, imported from GitHub Actions."

node on terminal "Pull request or push"

group job_generated "Generated diagrams match their files" sub="Calls plotwork.yml" {
  node generated step "Generated diagrams match their files" sub="Calls plotwork.yml"
}

group job_diagrams "Hand-written diagrams are valid and drawn" sub="ubuntu-latest" {
  node diagrams_1 step "Checkout" icon=lucide:git-branch
  node diagrams_2 step "Plotwork official plotwork"
}

on -> generated
on -> diagrams_1
diagrams_1 -> diagrams_2
