# Fingerprint: ff198d9a5864f4c4
flow "Parcel events on RabbitMQ" direction=down desc="3 applications and the 2 channels where they meet: an arrow into a channel sends to it, an arrow out of one receives from it, labelled with the messages. Imported from AsyncAPI."

node tracking_api service "Tracking API" sub="Version 1.8.2"
node carrier_event_worker service "Carrier event worker" sub="Version 1.8.2"
node webhook_sender service "Webhook sender" sub="Version 1.3.0"

group amqp "AMQP broker" type=messaging sub="tracking-rabbitmq.tracking:5672" {
  node carrier_scans queue "carrier.scans"
}

group amqp_2 "AMQP broker" type=messaging {
  node parcel_status queue "parcel.status" sub="The new status of a parcel, once per change."
}

carrier_scans -> carrier_event_worker : "CarrierScan" icon=lucide:inbox
carrier_event_worker -> parcel_status : "ParcelStatusChanged, ParcelDelivered" icon=lucide:send
tracking_api -> carrier_scans : "CarrierScan" icon=lucide:send
parcel_status -> webhook_sender : "ParcelStatusChanged, ParcelDelivered" icon=lucide:inbox
