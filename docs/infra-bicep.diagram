# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint on Azure, from Bicep" direction=down provider=azure desc="28 resources on Azure, framed by the module that declares them and nested in the groups, networks, and subnets that hold them, imported from Bicep. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret."

group azure_account "Azure subscription" type=account {

  group rg "rg-parcel-prod" type=resource-group sub="westeurope" {

    group monitoring "Monitoring" type=observability icon=lucide:package sub="Module modules/monitoring.bicep" {
      node workspace service "log-parcel-prod" sub="Log Analytics workspace" icon=azure:log-analytics-workspaces
      node insights service "appi-parcel-prod" sub="Application Insights" icon=azure:application-insights
    }

    group compute "Compute" type=resource-group icon=lucide:package sub="Module modules/compute.bicep" {
      node identity identity "id-parcel-prod-apps" sub="Managed identity" icon=azure:managed-identities

      group plan "asp-parcel-prod" type=service-plan {
        node api service "app-parcel-prod-api" sub="App Service" icon=azure:app-service
        node worker function "func-parcel-prod-events" sub="Function app" icon=azure:functions
        node plan_service_plan service "Service plan" sub="P1v3" icon=azure:app-service-plans
      }
    }

    group network "Network" type=network icon=lucide:package sub="Module modules/network.bicep" {
      node postgres_dns gateway "privatelink.postgres.database.azure.com" sub="Private DNS zone" icon=azure:dns-zones

      group vnet "vnet-parcel-prod" type=network sub="10.20.0.0/16" {
        node vnet_network service "Virtual network" icon=azure:virtual-network

        group app "snet-parcel-prod-app" type=subnet sub="10.20.1.0/24" {
          node app_nsg secret "nsg-parcel-prod-app" sub="Network security group" icon=azure:network-security-groups
          node app_subnet service "Subnet" icon=azure:subnet
        }

        group data "snet-parcel-prod-data" type=subnet sub="10.20.2.0/24" {
          node data_subnet service "Subnet" icon=azure:subnet
        }

        group endpoints "snet-parcel-prod-endpoints" type=subnet sub="10.20.3.0/24" {
          node endpoints_subnet service "Subnet" icon=azure:subnet
        }
      }
    }

    group data_2 "Data" type=resource-group icon=lucide:package sub="Module modules/data.bicep" {
      node labels_endpoint gateway "pe-parcel-prod-labels" sub="Private endpoint" icon=azure:private-endpoints

      group postgres_group "psql-parcel-prod" type=data-tier icon=azure:database-for-postgresql {
        node postgres database "PostgreSQL flexible server" sub="Standard_D2ds_v5" icon=azure:database-for-postgresql
        node tracking database "tracking" sub="Database" icon=azure:database-for-postgresql
      }

      group labels_group "stparcelprodlabels" type=storage-account icon=azure:storage-accounts {
        node labels storage "Storage account" icon=azure:storage-accounts
        node container_1 storage "labels" sub="Blob container" icon=azure:storage-container
      }

      group service_bus_group "sb-parcel-prod" type=messaging icon=azure:service-bus {
        node service_bus queue "Service Bus namespace" sub="Standard" icon=azure:service-bus
        node carrier_events queue "carrier-events" sub="Service Bus queue" icon=azure:service-bus
      }

      group vault_group "kv-parcel-prod" type=security icon=azure:key-vault {
        node vault secret "Key Vault" icon=azure:key-vault
        node postgres_password_secret secret "postgres-password" sub="Secret" icon=azure:keys
      }
    }
  }
}

insights -> workspace : "logs" icon=lucide:activity
app_nsg -> workspace : "diagnostics"
postgres_dns -> vnet_network : "DNS link"
postgres -> data_subnet : "subnet"
postgres -> postgres_dns : "DNS"
labels_endpoint -> labels : "private link" icon=lucide:lock role=private
labels_endpoint -> endpoints_subnet : "subnet"
identity -> labels : "Storage Blob Data Contributor" icon=lucide:key-round role=identity
identity -> service_bus : "Azure Service Bus Data Receiver" icon=lucide:key-round role=identity
identity -> vault : "Key Vault Secrets User" icon=lucide:key-round role=identity
plan_service_plan -> identity : "identity (2)" icon=lucide:key-round role=identity
plan_service_plan -> app_subnet : "VNet integration (2)" icon=lucide:lock role=private
plan_service_plan -> insights : "telemetry (2)" icon=lucide:activity
plan_service_plan -> postgres : "data (2)" icon=lucide:database role=data
