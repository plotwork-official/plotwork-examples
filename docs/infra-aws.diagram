# The next run writes over this file. Put changes in docs/infra-aws.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint on AWS, from CloudFormation" direction=down provider=aws desc="7 resources on AWS, nested in the groups, networks, and subnets that hold them, imported from CloudFormation. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret."

group aws_account "AWS account" type=account {
  node tracking_api gateway "parcel-prod-api" sub="API Gateway" icon=aws:api-gateway
  node track_parcel function "parcel-prod-track" sub="Lambda" icon=aws:lambda
  node carrier_events function "parcel-prod-events" sub="Lambda" icon=aws:lambda
  node parcels database "parcel-prod-parcels" sub="DynamoDB" icon=aws:dynamodb
  node labels storage "parcel-prod-labels" sub="S3 bucket" icon=aws:s3
  node carrier_events_queue queue "parcel-prod-carrier-events" sub="SQS queue" icon=aws:sqs
  node carrier_events_dead_letters queue "parcel-prod-carrier-events-dlq" sub="SQS queue" icon=aws:sqs
}

tracking_api -> track_parcel : "GET /parcels/{id}"
track_parcel -> parcels : "data"
track_parcel -> labels : "storage"
carrier_events -> parcels : "data"
carrier_events_queue -> carrier_events_dead_letters : "dead letters"
carrier_events_queue -> carrier_events : "triggers"
