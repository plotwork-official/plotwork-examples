flow "Who owns what in Parcelpoint's catalog" direction=down desc="15 entities of a Backstage catalog, framed by the group that owns them. An arrow says a component provides or consumes an API, or depends on another entity."

group engineering "Engineering" type=identity-boundary icon=lucide:users sub="Group, department, Ana Costa" {

  group team_tracking "Tracking team" type=identity-boundary icon=lucide:users sub="Group, team, Mara Lindqvist, Tobi Adeyemi" {
    node tracking_api service "Tracking API" sub="Service, in tracking"
    node event_worker service "Carrier event worker" sub="Service, in tracking"
    node tracking_rest gateway "Tracking REST API" sub="OpenAPI API, in tracking" icon=simple:swagger
    node parcel_events gateway "Parcel events" sub="AsyncAPI API, in tracking" icon=lucide:radio
    node tracking_db database "Tracking database (Postgres)" sub="Resource, database, in tracking" icon=simple:postgresql
    node carrier_events queue "Carrier events (RabbitMQ)" sub="Resource, queue, in tracking" icon=simple:rabbitmq
  }

  group team_labels "Labels team" type=identity-boundary icon=lucide:users sub="Group, team, Priya Raman" {
    node label_intake service "Label intake" sub="Service, in labels"
    node label_renderer service "Label renderer" sub="Service, in labels"
    node label_requests gateway "Label requests" sub="OpenAPI API, in labels" icon=simple:swagger
    node label_requests_queue queue "Label requests (Amazon SQS)" sub="Resource, queue, in labels" icon=aws:sqs
    node label_jobs database "Label jobs (DynamoDB)" sub="Resource, database, in labels"
    node label_store storage "Label PDFs (Amazon S3)" sub="Resource, s3-bucket, in labels" icon=aws:s3
  }

  group team_integrations "Integrations team" type=identity-boundary icon=lucide:users sub="Group, team, Jonas Weber" {
    node merchant_dashboard client "Merchant dashboard" sub="Website, in merchant-integrations" icon=lucide:monitor-smartphone
    node webhook_sender service "Webhook sender" sub="Service, in merchant-integrations"
    node parcelpoint_node service "Node SDK" sub="Library, experimental, in merchant-integrations" icon=lucide:package
  }
}

merchant_dashboard -> tracking_rest : "consumes" icon=lucide:plug-zap
webhook_sender -> parcel_events : "consumes" icon=lucide:plug-zap
parcelpoint_node -> tracking_rest : "consumes" icon=lucide:plug-zap
label_intake -> label_requests : "provides" icon=lucide:plug
label_intake -> label_requests_queue : "depends on" icon=lucide:link
label_intake -> label_jobs : "depends on" icon=lucide:link
