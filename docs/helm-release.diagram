flow "The tracking release, from helm template" direction=down desc="4 workloads and 4 objects around them, imported from a Helm chart rendered with helm template. Traffic flows from each Ingress to the pods behind its Services, and dashed arrows are configuration the pods read."

group tracking "tracking" type=resource-group icon=simple:helm sub="Release" tone=blue {

  group tracking_2 "tracking" type=resource-group icon=lucide:package sub="Chart 0.4.0" {
    node tracking_3 gateway "tracking" sub="Ingress, api.parcelpoint.example" icon=lucide:globe
    node tracking_api service "tracking-api" sub="Deployment, 2 replicas, port 80"
    node tracking_worker service "tracking-worker" sub="Deployment"
    node tracking_config storage "tracking-config" sub="ConfigMap" icon=lucide:settings-2
  }

  group postgresql "postgresql" type=resource-group icon=lucide:package sub="Chart 15.5.20" {
    node tracking_postgresql database "tracking-postgresql" sub="StatefulSet, port 5432" icon=simple:postgresql
    node tracking_postgresql_2 secret "tracking-postgresql" sub="Secret" icon=lucide:key-round
  }

  group rabbitmq "rabbitmq" type=resource-group icon=lucide:package sub="Chart 14.6.6" {
    node tracking_rabbitmq queue "tracking-rabbitmq" sub="StatefulSet, port 5672" icon=simple:rabbitmq
    node tracking_rabbitmq_2 secret "tracking-rabbitmq" sub="Secret" icon=lucide:key-round
  }
}

tracking_3 -> tracking_api : "api.parcelpoint.example" icon=lucide:globe
tracking_api -> tracking_postgresql
tracking_api -> tracking_rabbitmq
tracking_api --> tracking_config : "reads" icon=lucide:eye
tracking_api --> tracking_postgresql_2 : "reads" icon=lucide:key-round role=identity
