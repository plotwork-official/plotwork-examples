flow "The label service's Azure pipeline" direction=down desc="6 jobs in 3 stages, 2 of which deploy to an environment, in the order dependsOn sets. A dashed arrow reaches a job that runs only when its condition holds. Imported from Azure Pipelines."

node pipeline terminal "Pipeline starts" icon=azure:devops

group stage_build "Build and test" type=ci-cd {
  node test step "Unit tests" sub="2 matrix runs, ubuntu-24.04, 3 steps" icon=lucide:flask-conical
  node synth step "Synthesize the cloud assembly" sub="ubuntu-24.04, 4 steps" icon=aws:cloud-development-kit
  node audit step "Licence and vulnerability audit" sub="when its condition holds, ubuntu-24.04, 1 step" icon=lucide:scan-search
}

group stage_staging "Deploy to staging" type=ci-cd {
  node deploy_staging step "cdk deploy" sub="when its condition holds, deploys to labels-staging, ubuntu-24.04, 2 steps" icon=aws:cloud-development-kit
  node smoke step "Print a test label" sub="when its condition holds, ubuntu-24.04, 1 step" icon=lucide:flask-conical
}

group stage_production "Deploy to production" type=ci-cd {
  node deploy_production step "cdk deploy" sub="deploys to labels-production, ubuntu-24.04, 3 steps" icon=aws:cloud-development-kit
}

test -> synth
pipeline -> test
pipeline --> audit
deploy_staging --> smoke
synth --> deploy_staging
audit --> deploy_staging
smoke -> deploy_production
