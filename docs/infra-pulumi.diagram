flow "Parcelpoint on Azure, from Pulumi" direction=down provider=azure desc="29 resources on Azure, nested in the groups that hold them, beside the network, with an arrow to the subnet each one sits in, imported from Pulumi. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret." legend=off

group azure_account "Azure subscription" type=account {

  group rg "rg-parcel-prod" type=resource-group {
    node postgres_dns gateway "privatelink.postgres.database.azure.com" sub="Private DNS zone" icon=azure:dns-zones
    node labels_endpoint gateway "pe-parcel-prod-labels" sub="Private endpoint" icon=azure:private-endpoints
    node workspace service "log-parcel-prod" sub="Log Analytics workspace PerGB2018" icon=azure:log-analytics-workspaces
    node insights service "appi-parcel-prod" sub="Application Insights web" icon=azure:application-insights
    node identity identity "id-parcel-prod-apps" sub="Managed identity" icon=azure:managed-identities

    group vnet "vnet-parcel-prod" type=network sub="10.20.0.0/16" {
      node vnet_network service "Virtual network" icon=azure:virtual-network

      group app_subnet "snet-parcel-prod-app" type=subnet sub="10.20.1.0/24" {
        node app_nsg secret "nsg-parcel-prod-app" sub="Network security group" icon=azure:network-security-groups
        node app_subnet_subnet service "Subnet" icon=azure:subnet
      }

      group data_subnet "snet-parcel-prod-data" type=subnet sub="10.20.2.0/24" {
        node data_subnet_subnet service "Subnet" icon=azure:subnet
      }

      group endpoint_subnet "snet-parcel-prod-endpoints" type=subnet sub="10.20.3.0/24" {
        node endpoint_subnet_subnet service "Subnet" icon=azure:subnet
      }
    }

    group postgres_group "psql-parcel-prod" type=data-tier icon=azure:database-for-postgresql {
      node postgres_password service "Postgres password" sub="Password" icon=lucide:key-round
      node postgres database "PostgreSQL flexible server" sub="Standard_D2ds_v5" icon=azure:database-for-postgresql
      node tracking database "tracking" sub="Database" icon=azure:database-for-postgresql
    }

    group labels_group "stparcelprodlabels" type=storage-account icon=azure:storage-accounts {
      node labels storage "Storage account" icon=azure:storage-accounts
      node labels_container storage "labels" sub="Blob container" icon=azure:storage-container
    }

    group service_bus_group "sb-parcel-prod" type=messaging icon=azure:service-bus {
      node service_bus queue "Service Bus namespace" sub="Standard" icon=azure:service-bus
      node carrier_events queue "carrier-events" sub="Service Bus queue" icon=azure:service-bus
    }

    group vault_group "kv-parcel-prod" type=security icon=azure:key-vault {
      node vault secret "Key Vault" icon=azure:key-vault
      node postgres_password_secret secret "postgres-password" sub="Secret" icon=azure:keys
    }

    group plan "asp-parcel-prod" type=service-plan {
      node api service "app-parcel-prod-api" sub="App Service" icon=azure:app-service
      node worker function "func-parcel-prod-events" sub="Function app" icon=azure:functions
      node plan_service_plan service "Service plan" sub="P1v3" icon=azure:app-service-plans
    }
  }
}

