flow "The webhook sender's overlays, bases, and components" direction=down desc="4 kustomizations, 2 overlays among them, imported from a Kustomize folder. Each frame is a kustomization with the files, patches, and generators it lists; an arrow shows what an overlay builds on or includes, and what a patch changes."

group overlays_dev "overlays/dev" type=environment icon=lucide:layers sub="Overlay" {
  node dev_kustomization service "dev" sub="namespace webhooks-dev, prefix dev-, webhook-sender:main" icon=lucide:layers
  node webhook_config storage "webhook-config" sub="ConfigMap generator" icon=k8s:configmap
}

group overlays_prod "overlays/prod" type=environment icon=lucide:layers sub="Overlay" {
  node prod_kustomization service "prod" sub="namespace webhooks, webhook-sender:1.3.0, webhook-sender 3 replicas" icon=lucide:layers
  node redeliver function "webhook-redeliver" sub="CronJob, redeliver.yaml" icon=k8s:cronjob
  node resources_patch service "resources.yaml" sub="Patch of Deployment webhook-sender" icon=lucide:file-code
}

group components_tracing "components/tracing" type=resource-group icon=lucide:layers sub="Component" {
  node tracing_kustomization service "tracing" sub="kustomization.yaml" icon=lucide:layers
  node otel_env_patch service "otel-env.yaml" sub="Patch of Deployment webhook-sender" icon=lucide:file-code
}

group base "base" type=resource-group icon=lucide:layers sub="Base" {
  node base_kustomization service "base" sub="kustomization.yaml" icon=lucide:layers
  node deployment service "webhook-sender" sub="Deployment, deployment.yaml" icon=k8s:deployment
  node service gateway "webhook-sender" sub="Service, service.yaml" icon=k8s:service
  node webhook_config_2 storage "webhook-config" sub="ConfigMap generator" icon=k8s:configmap
  node webhook_queue secret "webhook-queue" sub="Secret generator" icon=k8s:secret
}

dev_kustomization -> base_kustomization : "builds on" icon=lucide:layers
prod_kustomization -> base_kustomization : "builds on" icon=lucide:layers
prod_kustomization -> tracing_kustomization : "includes" icon=lucide:package
resources_patch -> deployment : "patches" icon=lucide:replace
otel_env_patch -> deployment : "patches" icon=lucide:replace
deployment --> webhook_config : "reads" icon=lucide:eye
deployment --> webhook_config_2 : "reads" icon=lucide:eye
deployment --> webhook_queue : "reads" icon=lucide:key-round role=identity
service -> deployment
redeliver --> webhook_config : "reads" icon=lucide:eye
redeliver --> webhook_config_2 : "reads" icon=lucide:eye
redeliver --> webhook_queue : "reads" icon=lucide:key-round role=identity
