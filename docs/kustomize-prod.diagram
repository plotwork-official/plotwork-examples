flow "The webhook sender in production, from kustomize build" direction=down desc="2 workloads and 2 objects around them, imported from the output of kustomize build. Solid arrows are calls to a Service, and dashed arrows are configuration the pods read."

node webhook_sender service "webhook-sender" sub="Deployment, 3 replicas, port 9090" icon=k8s:deployment
node webhook_redeliver function "webhook-redeliver" sub="CronJob" icon=k8s:cronjob
node webhook_config storage "webhook-config" sub="ConfigMap" icon=k8s:configmap
node webhook_queue secret "webhook-queue" sub="Secret" icon=k8s:secret

webhook_sender --> webhook_config : "reads" icon=lucide:eye
webhook_sender --> webhook_queue : "reads" icon=lucide:key-round role=identity
webhook_redeliver --> webhook_config : "reads" icon=lucide:eye
