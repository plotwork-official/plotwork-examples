# Generated by plotwork generate from the source api (openapi: api/openapi.json).
# The next run writes over this file. Put changes in docs/api.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
tree "Parcelpoint tracking API endpoints" counts=on desc="The 10 endpoints of the Parcelpoint tracking API by tag (shipments, tracking, and webhooks), imported from its OpenAPI document."

dir "shipments" note="Shipments and their labels" icon=lucide:tag {
  file "GET /shipments" note="List shipments" icon=lucide:route
  file "POST /shipments" note="Create a shipment" icon=lucide:route
  file "GET /shipments/{id}" note="Get a shipment" icon=lucide:route
  file "DELETE /shipments/{id}" note="Cancel a shipment" icon=lucide:route
  file "GET /shipments/{id}/label" note="Download the label PDF" icon=lucide:route
}
dir "tracking" note="Where a parcel is" icon=lucide:tag {
  file "GET /parcels/{code}" note="Track a parcel" icon=lucide:route
  file "GET /parcels/{code}/events" note="List a parcel's events" icon=lucide:route
  file "POST /carrier-events" note="Receive an event from a carrier" icon=lucide:route
}
dir "webhooks" note="Events sent to a merchant" icon=lucide:tag {
  file "GET /webhooks" note="List webhooks" icon=lucide:route
  file "POST /webhooks" note="Add a webhook" icon=lucide:route
}
