# Generated by plotwork generate from the source cluster (kubernetes: k8s).
# The next run writes over this file. Put changes in docs/cluster.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint on Kubernetes" direction=down desc="3 workloads and 4 objects around them, imported from Kubernetes manifests. Traffic flows from each Ingress to the pods behind its Services, and dashed arrows are configuration the pods read."

node tracking gateway "tracking" sub="Ingress, api.parcelpoint.example" icon=lucide:globe
node tracking_api service "tracking-api" sub="Deployment, 2 replicas, port 80"
node event_worker service "event-worker" sub="Deployment"
node postgres database "postgres" sub="StatefulSet" icon=simple:postgresql
node postgres_data storage "postgres-data" sub="PersistentVolumeClaim, 20Gi" icon=lucide:hard-drive
node tracking_config storage "tracking-config" sub="ConfigMap" icon=lucide:settings-2
node tracking_db secret "tracking-db" sub="Secret" icon=lucide:key-round

tracking -> tracking_api : "api.parcelpoint.example" icon=lucide:globe
tracking_api --> tracking_config : "reads" icon=lucide:eye
tracking_api --> tracking_db : "reads" icon=lucide:key-round role=identity
event_worker --> tracking_config : "reads" icon=lucide:eye
event_worker --> tracking_db : "reads" icon=lucide:key-round role=identity
postgres -> postgres_data : "mounts" icon=lucide:hard-drive role=data
