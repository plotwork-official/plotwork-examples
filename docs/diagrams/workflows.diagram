# The next run writes over this file. Put changes in docs/diagrams/workflows.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "scale" direction=down desc="1 job and their steps of the scale workflow, started by a manual run or the schedule 23 6 * * 1, in the order their needs set, imported from GitHub Actions."

node on terminal "Manual run or schedule"

group job_scale "Scale test" type=ci-cd sub="ubuntu-latest" {
  node scale_1 step "Checkout" icon=simple:github
  node scale_2 step "Pick the version"
  node scale_3 step "Checkout" icon=simple:github
  node scale_4 step "Make the monorepo, twice"
  node scale_5 step "Measure a full write and a check"
  node scale_6 step "The check after a write passes, the output is the same twice, and the summary fits"
}

on -> scale_1
scale_1 -> scale_2
scale_2 -> scale_3
scale_3 -> scale_4
scale_4 -> scale_5
scale_5 -> scale_6
