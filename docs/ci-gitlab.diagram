# Generated by plotwork generate from the source ci-gitlab (gitlab-ci: pipelines/gitlab/.gitlab-ci.yml).
# The next run writes over this file. Put changes in docs/ci-gitlab.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "The webhook sender's GitLab pipeline" direction=down desc="8 jobs in 3 stages, 2 of which start another pipeline, in the order they run: by needs, or stage after stage. A dashed arrow reaches a job that runs by hand or by its rules. Imported from GitLab CI/CD."

node pipeline terminal "Pipeline starts"
node chart_pipeline external "chart/.gitlab-ci.yml" sub="Child pipeline" icon=simple:gitlab
node docs_pipeline external "parcelpoint/developer-docs" sub="Downstream pipeline" icon=simple:gitlab

group stage_test "test" type=ci-cd {
  node lint step "lint" sub="golangci-lint:v1.61"
  node unit step "unit" sub="2 matrix runs, golang:1.23" icon=simple:go
  node contract step "contract" sub="golang:1.23, may fail" icon=simple:go
}

group stage_build "build" type=ci-cd {
  node docker_image step "docker-image" sub="docker:27"
  node chart step "chart" sub="when its rules match, golang:1.23" icon=simple:go
}

group stage_deploy "deploy" type=ci-cd {
  node staging step "staging" sub="when its rules match, deploys to staging, k8s:1.31.1"
  node production step "production" sub="manual, deploys to production, k8s:1.31.1"
  node docs step "docs" sub="golang:1.23" icon=simple:go
}

chart -> chart_pipeline : "triggers" icon=lucide:zap
docs -> docs_pipeline : "triggers" icon=lucide:zap
pipeline -> lint
pipeline -> unit
unit -> contract
lint -> docker_image
unit -> docker_image
lint --> chart
unit --> chart
contract --> chart
docker_image --> staging
staging --> production
production -> docs
