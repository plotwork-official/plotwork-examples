# Generated by plotwork generate from the source c4-containers (structurizr: architecture/workspace.dsl).
# The next run writes over this file. Put changes in docs/c4-containers.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
c4 "Parcelpoint's containers" view=container direction=down desc="The containers of Parcelpoint and what they talk to, imported from the Structurizr workspace Parcelpoint."

person customer "Customer" desc="Waits for a parcel." external=on

boundary parcelpoint_2 "Parcelpoint" kind=enterprise icon=lucide:building tone=neutral {
  person merchant "Merchant" desc="Ships goods to customers."
  person support "Support agent" desc="Answers where a parcel is."

  boundary parcelpoint "Parcelpoint" kind=system icon=lucide:blocks tone=blue {
    container dashboard "Merchant dashboard" tech="React" desc="Creates shipments and prints labels."
    container api "Tracking API" tech="TypeScript" desc="Shipments, parcels, and their events over HTTPS. Holds 4 components."
    container worker "Carrier event worker" tech="TypeScript" desc="Moves each parcel along as scans arrive."
    container webhooks "Webhook sender" tech="Go" desc="Posts parcel events to merchants' webhooks."
    container labels "Label service" tech="AWS Lambda" desc="Renders each carrier's label as a PDF."
    db db_1 "Tracking database" tech="PostgreSQL" desc="Merchants, shipments, parcels, and events."
    container queue "Carrier events" tech="RabbitMQ" desc="Scans waiting to be applied."
    db labelStore "Label PDFs" tech="Amazon S3" desc="Every printed label, kept for a year."
  }
}

system carrier "Carriers" desc="Collect and deliver parcels, and report each scan." external=on
system email "Email service" desc="Sends tracking updates." external=on

merchant -> dashboard : "Creates shipments with" tech="HTTPS"
support -> dashboard : "Looks parcels up on" tech="HTTPS"
customer -> api : "Follows a parcel on" tech="HTTPS"
dashboard -> api : "Creates shipments" tech="JSON/HTTPS"
carrier -> api : "Reports scans" tech="Webhooks"
api -> labels : "Asks for labels" tech="HTTPS, signed"
api -> queue : "Queues scans on" tech="AMQP"
api -> db_1 : "Reads and writes" tech="SQL"
worker -> queue : "Takes scans from" tech="AMQP"
worker -> db_1 : "Updates parcels in" tech="SQL"
worker -> webhooks : "Hands parcel events to" tech="AMQP"
worker -> email : "Sends updates through" tech="HTTPS"
webhooks -> merchant : "Posts parcel events to" tech="Webhooks"
labels -> carrier : "Books labels with" tech="HTTPS"
labels -> labelStore : "Keeps PDFs in" tech="S3"
email -> customer : "Emails"
