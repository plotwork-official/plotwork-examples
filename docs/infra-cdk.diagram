# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint's label printing on AWS, from the CDK" direction=down provider=aws desc="14 resources on AWS, framed by the construct that declares them and nested in the groups, networks, and subnets that hold them, imported from the AWS CDK. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret."

group aws_account "AWS account" type=account {

  group LabelPrinting "LabelPrinting" type=resource-group icon=lucide:package sub="Stack" {

    group Printing "Printing" type=resource-group icon=lucide:package sub="Construct" {
      node requests_dead_letters queue "parcel-prod-label-requests-dlq" sub="SQS queue" icon=aws:sqs
      node requests queue "parcel-prod-label-requests" sub="SQS queue" icon=aws:sqs
      node jobs database "parcel-prod-label-jobs" sub="DynamoDB" icon=aws:dynamodb
      node renderer function "parcel-prod-label-renderer" sub="Lambda nodejs22.x" icon=aws:lambda

      group renderer_service_role_group "Renderer service role" type=identity-boundary icon=aws:identity-access-management-role {
        node renderer_service_role identity "IAM role" icon=aws:identity-access-management-role
        node renderer_service_role_default_po identity "Renderer service role default policy" sub="Policy" icon=aws:iam
      }
    }

    group Alerts "Alerts" type=resource-group icon=lucide:package sub="Nested stack" {
      node on_call queue "parcel-prod-label-alerts" sub="SNS topic" icon=aws:sns
      node dead_letters_alarm service "Dead letters alarm" sub="Cloudwatch alarm" icon=aws:cloudwatch-alarm
    }

    group Api "API" type=resource-group icon=lucide:package sub="Construct" {

      group intake_service_role_group "Intake service role" type=identity-boundary icon=aws:identity-access-management-role {
        node intake_service_role identity "IAM role" icon=aws:identity-access-management-role
        node intake_service_role_default_poli identity "Intake service role default policy" sub="Policy" icon=aws:iam
      }

      group intake_group "parcel-prod-label-intake" type=app-tier icon=aws:lambda {
        node intake function "Lambda" sub="nodejs22.x" icon=aws:lambda
        node intake_function_url function "Intake function URL" sub="URL" icon=aws:lambda
      }
    }
  }

  group LabelStorage "LabelStorage" type=resource-group icon=lucide:package sub="Stack" {
    node labels storage "parcel-prod-labels" sub="S3 bucket" icon=aws:s3
  }
}

requests -> requests_dead_letters : "dead letters" icon=lucide:send role=async
renderer_service_role_default_po -> requests : "messages" icon=lucide:key-round role=identity
renderer_service_role_default_po -> jobs : "data" icon=lucide:key-round role=identity
renderer_service_role_default_po -> labels : "storage" icon=lucide:key-round role=identity
renderer --> renderer_service_role_default_po : "depends on" icon=lucide:link
renderer -> jobs : "data" icon=lucide:database role=data
renderer -> labels : "storage" icon=lucide:database role=data
renderer -> renderer_service_role : "role" icon=lucide:key-round role=identity
requests -> renderer : "triggers" icon=lucide:zap
intake_service_role_default_poli -> requests : "messages" icon=lucide:key-round role=identity
intake_service_role_default_poli -> jobs : "data" icon=lucide:key-round role=identity
intake_service_role_default_poli -> labels : "storage" icon=lucide:key-round role=identity
intake --> intake_service_role_default_poli : "depends on" icon=lucide:link
intake -> jobs : "data" icon=lucide:database role=data
intake -> labels : "storage" icon=lucide:database role=data
intake -> requests : "messages" icon=lucide:send role=async
intake -> intake_service_role : "role" icon=lucide:key-round role=identity
dead_letters_alarm -> on_call : "messages" icon=lucide:send role=async
dead_letters_alarm -> requests_dead_letters : "messages" icon=lucide:send role=async
intake_function_url -> intake : "part of"
