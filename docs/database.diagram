schema "Tracking database" desc="5 tables and the 4 foreign keys between them, imported from SQL."

table merchants {
  id BIGSERIAL pk
  name TEXT
  api_token TEXT unique
  created_at TIMESTAMPTZ
}

table shipments {
  id BIGSERIAL pk
  merchant_id BIGINT fk
  reference TEXT
  label_key TEXT nullable
  created_at TIMESTAMPTZ
}

table parcels {
  id BIGSERIAL pk
  shipment_id BIGINT fk
  code TEXT unique
  weight_grams INTEGER
  status TEXT
}

table parcel_events {
  id BIGSERIAL pk
  parcel_id BIGINT fk
  carrier TEXT
  kind TEXT
  happened_at TIMESTAMPTZ
}

table webhooks {
  id BIGSERIAL pk
  merchant_id BIGINT fk
  url TEXT
  secret TEXT
}

shipments.merchant_id -> merchants.id
parcels.shipment_id -> shipments.id
parcel_events.parcel_id -> parcels.id
webhooks.merchant_id -> merchants.id
