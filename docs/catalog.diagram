# Generated by plotwork generate from the source catalog (backstage: catalog, !catalog/org/users.yaml).
# The next run writes over this file. Put changes in docs/catalog.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint's software catalog" direction=down desc="15 entities of a Backstage catalog, framed by 3 systems and the domains that hold them. An arrow says a component provides or consumes an API, or depends on another entity."

group delivery "Parcel delivery" type=resource-group icon=lucide:map sub="Domain, owned by engineering" tone=blue {

  group tracking "Tracking" type=app-tier icon=lucide:boxes sub="System, owned by team-tracking" {
    node tracking_api service "Tracking API" sub="Service, owned by team-tracking"
    node event_worker service "Carrier event worker" sub="Service, owned by team-tracking"
    node tracking_rest gateway "Tracking REST API" sub="OpenAPI API, owned by team-tracking" icon=simple:swagger
    node parcel_events gateway "Parcel events" sub="AsyncAPI API, owned by team-tracking" icon=lucide:radio
    node tracking_db database "Tracking database (Postgres)" sub="Resource, database, owned by team-tracking" icon=simple:postgresql
    node carrier_events queue "Carrier events (RabbitMQ)" sub="Resource, queue, owned by team-tracking" icon=simple:rabbitmq
  }

  group labels "Label printing" type=app-tier icon=lucide:boxes sub="System, owned by team-labels" {
    node label_intake service "Label intake" sub="Service, owned by team-labels"
    node label_renderer service "Label renderer" sub="Service, owned by team-labels"
    node label_requests gateway "Label requests" sub="OpenAPI API, owned by team-labels" icon=simple:swagger
    node label_requests_queue queue "Label requests (Amazon SQS)" sub="Resource, queue, owned by team-labels" icon=aws:sqs
    node label_jobs database "Label jobs (DynamoDB)" sub="Resource, database, owned by team-labels"
    node label_store storage "Label PDFs (Amazon S3)" sub="Resource, s3-bucket, owned by team-labels" icon=aws:s3
  }

  group merchant_integrations "Merchant integrations" type=app-tier icon=lucide:boxes sub="System, owned by team-integrations" {
    node merchant_dashboard client "Merchant dashboard" sub="Website, owned by team-integrations" icon=lucide:monitor-smartphone
    node webhook_sender service "Webhook sender" sub="Service, owned by team-integrations"
    node parcelpoint_node service "Node SDK" sub="Library, experimental, owned by team-integrations" icon=lucide:package
  }
}

merchant_dashboard -> tracking_rest : "consumes" icon=lucide:plug-zap
webhook_sender -> parcel_events : "consumes" icon=lucide:plug-zap
parcelpoint_node -> tracking_rest : "consumes" icon=lucide:plug-zap
label_intake -> label_requests : "provides" icon=lucide:plug
label_intake -> label_requests_queue : "depends on" icon=lucide:link
label_intake -> label_jobs : "depends on" icon=lucide:link
label_renderer -> label_requests_queue : "depends on" icon=lucide:link
label_renderer -> label_jobs : "depends on" icon=lucide:link
label_renderer -> label_store : "depends on" icon=lucide:link
tracking_api -> tracking_rest : "provides" icon=lucide:plug
tracking_api -> label_requests : "consumes" icon=lucide:plug-zap
tracking_api -> tracking_db : "depends on" icon=lucide:link
tracking_api -> carrier_events : "depends on" icon=lucide:link
event_worker -> parcel_events : "provides" icon=lucide:plug
event_worker -> tracking_db : "depends on" icon=lucide:link
event_worker -> carrier_events : "depends on" icon=lucide:link
