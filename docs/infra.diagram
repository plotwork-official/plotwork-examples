flow "Parcelpoint on Azure" direction=down provider=azure desc="29 resources on Azure, framed by the module that declares them and nested in the groups, networks, and subnets that hold them, imported from Terraform. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret." legend=left

group azure_account "Azure subscription" type=account {

  group main "rg-parcel-prod" type=resource-group sub="westeurope" {

    group monitoring "Monitoring" type=observability icon=lucide:package sub="Module modules/monitoring" {
      node this_3 service "log-parcel-prod" sub="Log Analytics workspace PerGB2018" icon=azure:log-analytics-workspaces
      node this_4 service "appi-parcel-prod" sub="Application Insights web" icon=azure:application-insights
    }

    group compute "Compute" type=resource-group icon=lucide:package sub="Module modules/compute" {
      node apps identity "id-parcel-prod-apps" sub="Managed identity" icon=azure:managed-identities

      group this_2 "asp-parcel-prod" type=service-plan {
        node api service "app-parcel-prod-api" sub="App Service" icon=azure:app-service
        node worker function "func-parcel-prod-events" sub="Function app" icon=azure:functions
        node this_service_plan service "Service plan" sub="P1v3 Linux" icon=azure:app-service-plans
      }
    }

    group network "Network" type=network icon=lucide:package sub="Module modules/network" {
      node postgres gateway "privatelink.postgres.database.azure.com" sub="Private DNS zone" icon=azure:dns-zones

      group this "vnet-parcel-prod" type=network {
        node this_network service "Virtual network" icon=azure:virtual-network

        group app "snet-parcel-prod-app" type=subnet {
          node app_2 secret "nsg-parcel-prod-app" sub="Network security group" icon=azure:network-security-groups
          node app_subnet service "Subnet" icon=azure:subnet
        }

        group data "snet-parcel-prod-data" type=subnet {
          node data_subnet service "Subnet" icon=azure:subnet
        }

        group endpoints "snet-parcel-prod-endpoints" type=subnet {
          node endpoints_subnet service "Subnet" icon=azure:subnet
        }
      }
    }

    group data_2 "Data" type=resource-group icon=lucide:package sub="Module modules/data" {
      node labels_3 gateway "pe-parcel-prod-labels" sub="Private endpoint" icon=azure:private-endpoints

      group this_group "psql-parcel-prod" type=data-tier icon=azure:database-for-postgresql {
        node postgres_2 service "Postgres password" icon=lucide:key-round
        node this_5 database "Tracking database" sub="GP_Standard_D2ds_v5" icon=azure:database-for-postgresql
        node tracking database "tracking" sub="Database" icon=azure:database-for-postgresql
      }

      group labels_group "stparcelprodlabels" type=storage-account icon=azure:storage-accounts {
        node labels storage "Shipping labels" sub="Storage account, label PDFs" icon=azure:storage-accounts
        node labels_2 storage "labels" sub="Blob container" icon=azure:storage-container
      }

      group this_group_2 "sb-parcel-prod" type=messaging icon=azure:service-bus {
        node this_6 queue "Service Bus namespace" sub="Standard" icon=azure:service-bus
        node carrier_events queue "Carrier events" sub="Service Bus queue" icon=azure:service-bus
      }

      group this_group_3 "kv-parcel-prod" type=security icon=azure:key-vault {
        node this_7 secret "Key Vault" sub="standard" icon=azure:key-vault
        node postgres_password secret "postgres-password" sub="Secret" icon=azure:keys
      }
    }
  }
}

