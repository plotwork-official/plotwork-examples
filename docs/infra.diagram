# Generated by plotwork generate from the source infra (terraform: infra/*.tf).
# The next run writes over this file. Put changes in docs/infra.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Parcelpoint on AWS" direction=right provider=aws desc="18 resources on AWS, nested in the groups, networks, and subnets that hold them, imported from Terraform. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret."

group aws_account "AWS account" type=account {
  node labels storage "Shipping labels" sub="S3 bucket, label PDFs" icon=aws:s3
  node carrier_events queue "Carrier events" sub="SQS queue" icon=aws:sqs
  node smoke_dead_letters queue "smoke-dead-letters" sub="SQS queue" icon=aws:sqs
  node main_2 service "parcelpoint" sub="ECS cluster" icon=aws:ecs
  node api_3 service "API task definition" icon=aws:ecs-task
  node worker service "Worker task definition" icon=aws:ecs-task

  group main "Parcelpoint VPC" type=network sub="10.20.0.0/16" {
    node api_2 gateway "parcelpoint-api" sub="Target group 8080" icon=aws:elastic-load-balancing
    node api_5 secret "api" sub="Security group" icon=aws:vpc-network-access-control-list

    group public_a "Public subnet" type=public-subnet sub="10.20.1.0/24 eu-west-1a" {
      node api gateway "parcelpoint-api" sub="Load balancer" icon=aws:elastic-load-balancing
    }

    group private_a "Private subnet" type=private-subnet sub="10.20.11.0/24 eu-west-1a" {
      node tracking service "tracking" sub="DB subnet group"
      node tracking_2 database "Tracking database" sub="RDS postgres db.t4g.medium" icon=aws:rds
      node api_4 service "tracking-api" sub="ECS service FARGATE" icon=aws:fargate
      node worker_2 service "event-worker" sub="ECS service FARGATE" icon=aws:fargate
    }
  }
}

tracking_2 -> tracking : "db subnet group"
api -> api_5 : "firewall"
api -> api_2 : "HTTPS 443"
api_3 -> tracking_2 : "data"
api_3 -> labels : "storage"
api_3 -> carrier_events : "messages"
worker -> tracking_2 : "data"
worker -> carrier_events : "messages"
api_4 -> main_2 : "cluster"
api_4 -> api_3 : "task definition"
api_4 -> api_5 : "firewall"
api_2 -> api_4
worker_2 -> main_2 : "cluster"
worker_2 -> worker : "task definition"
worker_2 -> api_5 : "firewall"
