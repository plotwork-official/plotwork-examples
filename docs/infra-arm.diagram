flow "Parcelpoint's label and event services, from an ARM template" direction=right provider=azure desc="8 resources on Azure, nested in the groups, networks, and subnets that hold them, imported from ARM. An arrow means one resource refers to another, and its label says how: a role, a private link, logs, or a secret."

group azure_account "Azure subscription" type=account {

  group resource_group "Resource group" type=resource-group {

    group storage_account_group "stparcelprodlabels" icon=azure:storage-accounts {
      node storage_account storage "Storage account" icon=azure:storage-accounts
      node labels storage "labels" sub="Blob container" icon=azure:storage-container
    }

    group namespace_group "sb-parcel-prod" icon=azure:service-bus {
      node namespace queue "Service Bus namespace" sub="Standard" icon=azure:service-bus
      node carrier_events queue "carrier-events" sub="Service Bus queue" icon=azure:service-bus
    }

    group serverfarm "asp-parcel-prod-events" type=service-plan sub="Y1" {
      node site function "func-parcel-prod-events" sub="Function app" icon=azure:functions
    }
  }
}

site -> storage_account : "Storage Blob Data Contributor, storage"
site -> namespace : "Azure Service Bus Data Receiver, messages"
labels -> storage_account : "part of"
carrier_events -> namespace : "part of"
