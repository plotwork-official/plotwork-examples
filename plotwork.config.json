{
  "$schema": "https://docs.plotwork.dev/schemas/plotwork.config.json",
  "defaults": {
    "scheme": "auto"
  },
  "sources": [
    {
      "name": "infra",
      "from": [
        "infra/terraform/**/*.tf",
        "infra/terraform/**/*.tfvars"
      ],
      "format": "terraform",
      "options": {
        "root": "envs/prod"
      },
      "out": "docs/infra.diagram",
      "title": "Parcelpoint on Azure",
      "publish": {
        "alias": "parcelpoint-infra"
      }
    },
    {
      "name": "infra-dev",
      "from": [
        "infra/terraform/**/*.tf",
        "infra/terraform/**/*.tfvars"
      ],
      "format": "terraform",
      "options": {
        "root": "envs/dev"
      },
      "out": "docs/infra-dev.diagram",
      "title": "Parcelpoint on Azure, development"
    },
    {
      "name": "infra-bicep",
      "from": "infra/bicep",
      "format": "bicep",
      "options": {
        "varFiles": [
          "infra/bicep/main.prod.bicepparam"
        ]
      },
      "out": "docs/infra-bicep.diagram",
      "title": "Parcelpoint on Azure, from Bicep"
    },
    {
      "name": "infra-arm",
      "from": "infra/arm",
      "format": "arm",
      "options": {
        "varFiles": [
          "infra/arm/azuredeploy.parameters.json"
        ]
      },
      "out": "docs/infra-arm.diagram",
      "title": "Parcelpoint's label and event services, from an ARM template"
    },
    {
      "name": "infra-pulumi",
      "from": [
        "infra/pulumi/Pulumi.yaml",
        "infra/pulumi/Pulumi.prod.yaml"
      ],
      "format": "pulumi",
      "options": {
        "varFiles": [
          "infra/pulumi/Pulumi.prod.yaml"
        ]
      },
      "out": "docs/infra-pulumi.diagram",
      "title": "Parcelpoint on Azure, from Pulumi"
    },
    {
      "name": "infra-pulumi-state",
      "from": "infra/pulumi/stack-export.json",
      "format": "pulumi",
      "out": "docs/infra-pulumi-state.diagram",
      "title": "Parcelpoint on Azure, from a Pulumi stack export"
    },
    {
      "name": "infra-aws",
      "from": "infra/cloudformation/template.yaml",
      "format": "cloudformation",
      "out": "docs/infra-aws.diagram",
      "title": "Parcelpoint on AWS, from CloudFormation"
    },
    {
      "name": "infra-cdk",
      "from": "infra/cdk/cdk.out",
      "format": "cdk",
      "out": "docs/infra-cdk.diagram",
      "title": "Parcelpoint's label printing on AWS, from the CDK"
    },
    {
      "name": "services",
      "from": "compose.yaml",
      "format": "compose",
      "out": "docs/architecture.md#services",
      "title": "Parcelpoint services on a laptop"
    },
    {
      "name": "cluster",
      "from": "k8s",
      "format": "kubernetes",
      "out": "docs/cluster.diagram",
      "title": "Parcelpoint on Kubernetes"
    },
    {
      "name": "helm-chart",
      "from": [
        "deploy/helm/tracking",
        "!deploy/helm/tracking/templates/**"
      ],
      "format": "helm",
      "out": "docs/helm-chart.diagram",
      "title": "The tracking chart and what it depends on"
    },
    {
      "name": "helm-release",
      "from": "deploy/helm/rendered/tracking.yaml",
      "format": "helm",
      "out": "docs/helm-release.diagram",
      "title": "The tracking release, from helm template"
    },
    {
      "name": "kustomize",
      "from": "deploy/kustomize/webhook-sender",
      "format": "kustomize",
      "out": "docs/kustomize.diagram",
      "title": "The webhook sender's overlays, bases, and components"
    },
    {
      "name": "kustomize-prod",
      "from": "deploy/kustomize/built/webhook-sender-prod.yaml",
      "format": "kustomize",
      "out": "docs/kustomize-prod.diagram",
      "title": "The webhook sender in production, from kustomize build"
    },
    {
      "name": "api",
      "from": "api/openapi.json",
      "format": "openapi",
      "view": "map",
      "out": "docs/api.diagram"
    },
    {
      "name": "api-access",
      "from": "api/openapi.json",
      "format": "openapi",
      "view": "endpoints",
      "out": "docs/api-access.diagram",
      "title": "Who may call each endpoint"
    },
    {
      "name": "catalog",
      "from": [
        "catalog",
        "!catalog/org/users.yaml"
      ],
      "format": "backstage",
      "out": "docs/catalog.diagram",
      "title": "Parcelpoint's software catalog"
    },
    {
      "name": "catalog-teams",
      "from": "catalog",
      "format": "backstage",
      "options": {
        "groupBy": "owner"
      },
      "out": "docs/catalog-teams.diagram",
      "title": "Who owns what in Parcelpoint's catalog"
    },
    {
      "name": "c4-containers",
      "from": "architecture/workspace.dsl",
      "format": "structurizr",
      "out": "docs/c4-containers.diagram"
    },
    {
      "name": "events",
      "from": "events",
      "format": "asyncapi",
      "out": "docs/events.diagram",
      "title": "Parcel events on RabbitMQ"
    },
    {
      "name": "database",
      "from": "db/schema.sql",
      "format": "sql",
      "out": "docs/database.diagram",
      "title": "Tracking database"
    },
    {
      "name": "ci",
      "from": ".github/workflows/check.yml",
      "format": "github-actions",
      "out": "docs/ci.diagram",
      "title": "Pull request checks"
    },
    {
      "name": "ci-gitlab",
      "from": "pipelines/gitlab/.gitlab-ci.yml",
      "format": "gitlab-ci",
      "out": "docs/ci-gitlab.diagram",
      "title": "The webhook sender's GitLab pipeline"
    },
    {
      "name": "ci-azure",
      "from": "pipelines/azure/azure-pipelines.yml",
      "format": "azure-pipelines",
      "out": "docs/ci-azure.diagram",
      "title": "The label service's Azure pipeline"
    },
    {
      "name": "shipments",
      "from": "data/shipments.csv",
      "format": "csv",
      "out": "docs/shipments.diagram",
      "title": "Shipments by region"
    },
    {
      "name": "workflows",
      "from": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "!.github/workflows/check.yml",
        "!.github/workflows/plotwork-check.yml",
        "!.github/workflows/plotwork-regenerate.yml",
        "!.github/workflows/plotwork-scan.yml",
        "!.github/workflows/regenerate.yml"
      ],
      "format": "github-actions",
      "out": "docs/diagrams/workflows.diagram"
    }
  ]
}
